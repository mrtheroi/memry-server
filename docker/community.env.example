# memry Community configuration.
# Copy to `.env` next to docker-compose.yml (or pass with --env-file).

# Image used by the app, scheduler and migrate services. Leave as is to build
# from a source checkout (`docker compose build`), or use the published image
# (`docker compose pull`), pinned to a release, e.g.
#   MEMRY_IMAGE=ghcr.io/mrtheroi/memry-server:<version>
MEMRY_IMAGE=memry-server:local

# Required. Generate with: docker compose run --rm --no-deps app key
APP_KEY=
# Public URL agents use to reach the server (https:// behind a TLS proxy).
APP_URL=http://localhost:8000
# Host port published by the app container.
APP_PORT=8000

# PostgreSQL 14+ (required). The bundled `postgres` service is used by default;
# point DB_HOST and friends at an existing server to use your own.
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=memry
DB_USERNAME=memry
DB_PASSWORD=change-me
DB_SSLMODE=prefer

# Run migrations automatically before the app starts (otherwise run the
# `migrate` service after every upgrade).
AUTO_MIGRATE=false

# Reverse proxy: "*" to trust the proxy in front of the container, or a comma
# separated list of proxy addresses / CIDR ranges. Leave empty without a proxy.
TRUSTED_PROXIES=

# Email login codes (optional). With `log`, codes are written to the container
# logs only. Use `smtp` to let users sign in themselves with an emailed code.
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=memry@example.com
MAIL_FROM_NAME=memry

# Dashboard (browser SPA) session login (optional). Leave all four empty if you only
# use the CLI and MCP clients: no browser origin is allowed and no session is used.
#   MEMRY_DASHBOARD_URL      browser origin(s) allowed by CORS, comma separated,
#                            for example https://app.example.com
#   SANCTUM_STATEFUL_DOMAINS dashboard host(s) that use the session cookie,
#                            for example app.example.com (include the port in development)
#   SESSION_DOMAIN           cookie domain shared by the dashboard and the API,
#                            for example .example.com
#   SESSION_SECURE_COOKIE    true to send cookies over HTTPS only (set it in production)
MEMRY_DASHBOARD_URL=
SANCTUM_STATEFUL_DOMAINS=
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=
